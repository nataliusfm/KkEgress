# ─────────────────────────────────────────────────────────────
# School Emergency Drill Tracking System — Environment Config
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# --- Server ---
PORT=3000
NODE_ENV=development

# Secret used to sign session JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated school email domains allowed to sign in (Google Sign-In).
# Example: school.edu,students.school.edu
ALLOWED_EMAIL_DOMAINS=school.edu

# Email of the first super administrator. This account is granted the
# SUPER_ADMIN role automatically on first sign-in.
BOOTSTRAP_SUPER_ADMIN=admin@school.edu

# Set to "true" to allow a password-less dev login endpoint (testing only).
# MUST be "false" in production.
ALLOW_DEV_LOGIN=false

# --- Google OAuth (Sign-In) ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth Client ID.
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
# Redirect URI registered in the OAuth client (for Drive/Sheets/Photos consent).
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Google Maps (frontend) ---
# Maps JavaScript API key. Restrict it to your domain in production.
GOOGLE_MAPS_API_KEY=your-google-maps-js-api-key

# --- Google Service Account (Sheets + Drive automation) ---
# Path to the service-account JSON key file. Share the target Sheet and Drive
# folder with the service account's email so it can write to them.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json

# The spreadsheet that drill records are appended to.
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEETS_TAB=Drill Records

# Root Drive folder ID for "School Emergency Drills".
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-drive-folder-id

# --- Google Photos ---
# Photos Library API requires user OAuth (service accounts are not supported).
# A refresh token obtained via the OAuth consent flow with the
# photoslibrary.appendonly scope.
GOOGLE_PHOTOS_REFRESH_TOKEN=
GOOGLE_PHOTOS_ALBUM_TITLE=Emergency Drill Records

# --- Email Notifications (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@school.edu
SMTP_PASS=your-smtp-app-password
NOTIFY_FROM="School Emergency Drills <notifications@school.edu>"
